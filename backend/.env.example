# Port the server listens on; open http://localhost:<PORT>
PORT=3001
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts (30m, 8h, 1d ...). Also the auth cookie's max-age.
JWT_EXPIRES_IN=8h
# SQLite database file (relative paths are relative to backend/)
DB_PATH=./data/flowsense.db
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=30
# true when the app is served over HTTPS
COOKIE_SECURE=false
# Used once, when no approved admin exists, to create the first admin.
# Log in with these and change the password straight away.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me
